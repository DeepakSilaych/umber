# Copy to .env for local dev. In production these are set as Dokploy env vars instead.

UMBER_DATABASE_URL=postgresql+psycopg://umber:umber@localhost:5432/umber

# Shared secret the phone is configured with once, to call POST /v1/devices/register.
UMBER_SETUP_KEY=dev-setup-key-change-me

# Single-user dashboard login.
UMBER_DASHBOARD_PASSWORD=dev-password-change-me
UMBER_JWT_SECRET=dev-jwt-secret-change-me-to-something-random

# Off for local http dev; the Dokploy deployment runs behind TLS and should leave this unset
# (defaults to true).
UMBER_COOKIE_SECURE=false

# Optional: a static bearer token for AI-agent access to /v1/transactions and /v1/statements.
# Leave unset to disable agent access entirely.
# UMBER_AGENT_API_TOKEN=

# LLM gateway for POST /v1/insights/generate (and the future /v1/classify job). Points at the
# existing self-hosted gateway — see Obsidian Infra/LLM Gateway.md for the real key.
UMBER_LLM_GATEWAY_URL=https://llm.deepaksilaych.me/v1
# UMBER_LLM_GATEWAY_KEY=
UMBER_LLM_MODEL=llama-3.3-70b-versatile
