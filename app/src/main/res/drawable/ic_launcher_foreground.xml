<?xml version="1.0" encoding="utf-8"?>
<!--
  Three ascending bars plus a baseline — the same mark as docs/logo.svg, so the launcher icon and
  the README logo are one design.

  Geometry is scaled to sit inside the adaptive-icon safe zone: every corner of every shape stays
  within radius 36 of centre (54,54), so a circular launcher mask can't clip the tallest bar or the
  ends of the baseline.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#F7EDE2"
        android:fillAlpha="0.55"
        android:pathData="M36,52 h5 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-5 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#F7EDE2"
        android:fillAlpha="0.78"
        android:pathData="M51,41 h5 a3,3 0 0 1 3,3 v23 a3,3 0 0 1 -3,3 h-5 a3,3 0 0 1 -3,-3 v-23 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#F7EDE2"
        android:pathData="M66,30 h5 a3,3 0 0 1 3,3 v34 a3,3 0 0 1 -3,3 h-5 a3,3 0 0 1 -3,-3 v-34 a3,3 0 0 1 3,-3 z" />

    <path
        android:fillColor="#F7EDE2"
        android:fillAlpha="0.32"
