<?xml version="1.0" encoding="utf-8"?>
<!--
  Umber gradient, matching docs/logo.svg. A vector rather than a flat colour so the icon has the
  same top-to-bottom fall-off as the logo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:startColor="#8C5A34"
                android:endColor="#4E2F1B" />
        </aapt:attr>
    </path>
</vector>
